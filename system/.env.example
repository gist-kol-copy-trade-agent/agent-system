# Application runtime
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WEBHOOK_SECRET=dev-secret

# Public callback URL that scraper uses to reach this app
APP_CALLBACK_URL_MESSAGES=http://localhost:8000/webhooks/scraper/messages

# Telegram polling bot token (required when running telegram worker)
TELEGRAM_BOT_TOKEN=

# OpenAI runtime
OPENAI_API_KEY=
OKX_AGENT_OPENAI__BASE_URL=
OKX_AGENT_OPENAI__ORGANIZATION=
OKX_AGENT_OPENAI__PROJECT=

# Persistence
# For local host run (outside Docker):
# OKX_AGENT_PERSISTENCE__DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/okx_agent
#
# For Docker Compose run:
OKX_AGENT_PERSISTENCE__DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/okx_agent

# LangGraph/checkpoint settings
OKX_AGENT_LANGGRAPH__CHECKPOINTER_BACKEND=memory
OKX_AGENT_LANGGRAPH__SIGNAL_DURABILITY=sync
OKX_AGENT_LANGGRAPH__EXIT_DURABILITY=sync
OKX_AGENT_LANGGRAPH__COMMAND_DURABILITY=async

# Monitoring/exit-cycle interval (seconds)
OKX_AGENT_MONITORING__POSITION_REFRESH_INTERVAL_SECONDS=60
