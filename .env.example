# Root compose reference file.
# Actual service env files live in:
# - system/.env
# - scraper/.env
#
# Root compose defaults can be overridden here if desired.

OKX_AGENT_PERSISTENCE__DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/okx_agent
OKX_AGENT_SCRAPER__BASE_URL=http://scraper:8010
OKX_AGENT_NOTIFICATIONS__MODE=standard
SCRAPER_DATABASE_URL=sqlite+pysqlite:///./data/scraper.db
